// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "agent": {
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.5",
    },
    "model_parameters": [],
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show": true,
  },
  "show_whitespaces": "selection",
  "hard_tabs": false,
  "collaboration_panel": {
    "dock": "right",
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
    },
  },
  "git_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "project_panel": {
    "dock": "right",
  },
  "tabs": {
    "show_diagnostics": "errors",
    "file_icons": false,
    "git_status": true,
    "close_position": "right",
  },
  "toolbar": {
    "code_actions": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "ui_font_weight": 250.0,
  "ui_font_family": ".ZedMono",
  "buffer_line_height": "comfortable",
  "disable_ai": false,
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "cursor_shape": "bar",
    "blinking": "on",
    "button": false,
    "shell": {
      "program": "cmd",
    },
    "font_family": "MesloLGMDZ Nerd Font",
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": false,
    "enabled": true,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "icon_theme": "Monospace Icon Theme - Dark",
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
